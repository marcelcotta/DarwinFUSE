prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: darwinfuse
Description: Userspace NFSv4-based FUSE for macOS (replaces macFUSE for the high-level libfuse 2.x API)
URL: https://github.com/marcelcotta/DarwinFUSE
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -ldarwinfuse
