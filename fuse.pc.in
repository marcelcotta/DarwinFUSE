prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: fuse
Description: DarwinFUSE — FUSE for macOS without a kernel extension (replaces macFUSE for the high-level libfuse 2.x API)
URL: https://github.com/marcelcotta/DarwinFUSE
Version: 2.9.9
Cflags: -I${includedir}/fuse -D_FILE_OFFSET_BITS=64
Libs: -L${libdir} -lfuse
